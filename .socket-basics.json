{
  "workspace": ".",
  "python_sast_enabled": true,
  "rust_sast_enabled": true,
  "rust_disabled_rules": "rust-panic-in-production",
  "sast_ignore_overrides": "rust-memory-safety:src/generated.rs,rust-memory-safety:xdr-generator-rust/generator/header.rs,rust-serde-security:src/generated.rs,rust-serde-security:xdr-generator-rust/generator/header.rs,rust-sql-injection:src/cli/xfile/preprocess.rs,rust-sql-injection:xdr-generator-rust/generator/src/generator.rs,rust-sql-injection:xdr-generator-rust/xdr-parser/src/parser.rs",
  "secret_scanning_enabled": true,
  "console_tabular_enabled": true,
  "socket_tier_1_enabled": false,
  "trivy_vuln_enabled": false,
  "trufflehog_exclude_dir": ".venv,venv,__pycache__,target,.git,yarn.lock,package-lock.json,pnpm-lock.yaml,Cargo.lock,go.sum,poetry.lock,Gemfile.lock,composer.lock,xdr"
}
