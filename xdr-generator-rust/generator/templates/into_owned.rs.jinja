{#- The `IntoOwned` impl of a generated type that has no `Ref`: it holds no
    heap data, so it appears as itself inside `Ref`s and its owned form is
    itself. The conversion consumes the value, so it hands it straight back. -#}
{%- macro identity(name, cfg) %}
{% if let Some(cfg) = cfg -%}
#[cfg({{ cfg }})]
{% endif -%}
#[cfg(feature = "alloc")]
impl IntoOwned for {{ name }} {
    type Owned = {{ name }};
    fn into_owned(self) -> {{ name }} {
        self
    }
}
{%- endmacro %}
