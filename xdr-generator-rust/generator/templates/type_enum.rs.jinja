{%- endif %}
            TypeVariant::{{ t.name }} => r.with_limited_depth(|r| Ok(Self::{{ t.name }}(Box::new({{ t.name }}::read_xdr(r)?)))),
{%- endfor %}
            TypeVariant::Int => r.with_limited_depth(|r| Ok(Self::Int(Box::new(i32::read_xdr(r)?)))),
            TypeVariant::UnsignedInt => r.with_limited_depth(|r| Ok(Self::UnsignedInt(Box::new(u32::read_xdr(r)?)))),
            TypeVariant::Hyper => r.with_limited_depth(|r| Ok(Self::Hyper(Box::new(i64::read_xdr(r)?)))),
            TypeVariant::UnsignedHyper => r.with_limited_depth(|r| Ok(Self::UnsignedHyper(Box::new(u64::read_xdr(r)?)))),
            TypeVariant::Bool => r.with_limited_depth(|r| Ok(Self::Bool(Box::new(bool::read_xdr(r)?)))),
            TypeVariant::OpaqueFixed(n) => r.with_limited_depth(|r| Ok(Self::OpaqueFixed(n, Box::new(BytesM(read_opaque_fixed(r, n)?))))),
            TypeVariant::OpaqueVar(max) => r.with_limited_depth(|r| Ok(Self::OpaqueVar(max, Box::new(BytesM(read_opaque_var(r, max)?))))),
