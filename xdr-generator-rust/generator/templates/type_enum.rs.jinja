pub enum TypeVariant {
{%- for t in type_variant_enum.types %}
{%- if let Some(cfg) = t.cfg %}
    #[cfg({{ cfg }})]
{%- endif %}
    {{ t.name }},
{%- endfor %}
    /// XDR `int`.
    Int,
    /// XDR `unsigned int`.
    UnsignedInt,
    /// XDR `hyper`.
    Hyper,
    /// XDR `unsigned hyper`.
    UnsignedHyper,
    /// XDR `bool`.
    Bool,
    /// XDR `opaque[n]`, fixed-length opaque data of `n` bytes.
    OpaqueFixed(u32),
    /// XDR `opaque<max>`, variable-length opaque data of at most `max` bytes.
    /// `opaque<>` has a `max` of `u32::MAX`.
    OpaqueVar(u32),
    /// XDR `string<max>`, a string of at most `max` bytes. `string<>` has a
    /// `max` of `u32::MAX`.
    StringVar(u32),
}

