            TypeVariant::Bool => Ok(Self::Bool(Box::new(bool::arbitrary(u)?))),
            TypeVariant::OpaqueFixed(n) => Ok(Self::OpaqueFixed(n, Box::new(BytesM(u.bytes(n as usize)?.to_vec())))),
            TypeVariant::OpaqueVar(max) => {
