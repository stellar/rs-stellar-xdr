                Ok(Self::OpaqueVar(max, Box::new(t)))
            }
            TypeVariant::StringVar(max) => {
                let t: StringM = serde::de::Deserialize::deserialize(r)?;
                if t.len() > max as usize {
                    return Err(Error::LengthExceedsMax);
                }
                Ok(Self::StringVar(max, Box::new(t)))
            }
        }
