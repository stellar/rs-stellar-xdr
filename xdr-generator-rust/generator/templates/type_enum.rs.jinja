        match v {
{%- for t in type_variant_enum.types %}
{%- if let Some(cfg) = t.cfg %}
            #[cfg({{ cfg }})]
{%- endif %}
            TypeVariant::{{ t.name }} => Ok(Self::{{ t.name }}(Box::new(serde::de::Deserialize::deserialize(r)?))),
{%- endfor %}
            TypeVariant::Int => Ok(Self::Int(Box::new(serde::de::Deserialize::deserialize(r)?))),
            TypeVariant::UnsignedInt => Ok(Self::UnsignedInt(Box::new(serde::de::Deserialize::deserialize(r)?))),
            TypeVariant::Hyper => Ok(Self::Hyper(Box::new(<NumberOrString as serde_with::DeserializeAs<i64>>::deserialize_as(r)?))),
