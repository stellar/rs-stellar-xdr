{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "HmacSha256Key",
  "description": "HmacSha256Key is an XDR Struct defined as:\n\n```text struct HmacSha256Key { opaque key[32]; }; ```",
  "type": "object",
  "required": [
    "key"
  ],
  "properties": {
    "$schema": {
