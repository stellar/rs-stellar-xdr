{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "ShortHashSeed",
  "description": "ShortHashSeed is an XDR Struct defined as:\n\n```text struct ShortHashSeed { opaque seed[16]; }; ```",
  "type": "object",
  "required": [
    "seed"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "seed": {
      "type": "string",
      "maxLength": 32,
      "minLength": 32,
      "contentEncoding": "hex",
      "contentMediaType": "application/binary"
    }
  },
  "unevaluatedProperties": false
}